<Window x:Class="BetterVoice.App.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterVoice Settings"
        Width="1000" Height="680" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#111317" Foreground="#F2F4F7"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="WindowBrush" Color="#111317" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#17191E" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1E24" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#20242B" />
            <SolidColorBrush x:Key="BorderBrush" Color="#30353E" />
            <SolidColorBrush x:Key="TextBrush" Color="#F2F4F7" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A9AFBA" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#7C8491" />
            <SolidColorBrush x:Key="AccentBrush" Color="#4C8BF5" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#639AF5" />
            <SolidColorBrush x:Key="FocusBrush" Color="#9BBEFA" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#65A77D" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4C8BF5" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#D94C8BF5" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B84C8BF5" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#79A7F7" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>

            <Style x:Key="PageHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,7" />
            </Style>

            <Style x:Key="UtilityTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </Style>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="NavItemStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="NavSurface" Background="Transparent" CornerRadius="6" Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="31" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ActiveRail" Width="3" Height="20" CornerRadius="1"
                                            Background="{StaticResource AccentBrush}" Opacity="0" />
                                    <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}" />
                                    <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavSurface" Property="Background" Value="#1D2026" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="NavSurface" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                    <Setter TargetName="ActiveRail" Property="Opacity" Value="1" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="NavSurface" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                                    <Setter TargetName="NavSurface" Property="BorderThickness" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="#3A404A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="13,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="Background" Value="#292E36" />
                                    <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#4A515D" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="Background" Value="#16191E" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                                    <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                    <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="Background" Value="#3E78D5" />
                                    <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#3E78D5" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                                    <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ProfessionalSliderStyle" TargetType="Slider">
                <Setter Property="Height" Value="22" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Background="Transparent">
                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                        Background="#777D87" />
                                <Track x:Name="PART_Track" VerticalAlignment="Center" Height="18">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="16" Height="16">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid>
                                                        <Ellipse Fill="#4A505A" />
                                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PART_Track" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SwitchStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Track" Width="38" Height="20" CornerRadius="10"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"
                                        Background="#373C45" BorderBrush="#505762" BorderThickness="1">
                                    <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="2"
                                             HorizontalAlignment="Left" Fill="#D7DBE2" />
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Top" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Thumb" Property="Fill" Value="White" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                                    <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CaptureModeStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="ModeSurface" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Ellipse x:Name="ModeRing" Stroke="#737B88" StrokeThickness="1.5" />
                                        <Ellipse x:Name="ModeDot" Width="7" Height="7" Fill="{StaticResource AccentBrush}" Opacity="0" />
                                    </Grid>
                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ModeSurface" Property="Background" Value="#1F2228" />
                                    <Setter TargetName="ModeSurface" Property="BorderBrush" Value="#424853" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ModeSurface" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                    <Setter TargetName="ModeSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="ModeRing" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="ModeDot" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ModeSurface" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                                    <Setter TargetName="ModeSurface" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="6,0,4,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="7" Background="#242830"
                            BorderBrush="#3B424D" BorderThickness="1">
                        <Grid>
                            <Ellipse Width="17" Height="17" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" />
                            <Rectangle Width="2" Height="9" RadiusX="1" RadiusY="1" Fill="{StaticResource TextBrush}" />
                            <Rectangle Width="2" Height="5" RadiusX="1" RadiusY="1" Fill="{StaticResource TextBrush}" Margin="-7,0,0,0" />
                            <Rectangle Width="2" Height="5" RadiusX="1" RadiusY="1" Fill="{StaticResource TextBrush}" Margin="7,0,0,0" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="BetterVoice" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Windows" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Text="Settings" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                           Margin="10,0,0,8" />

                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="OverviewNav" Content="Overview" Tag="&#xE80F;" GroupName="Navigation" IsChecked="True"
                                 Style="{StaticResource NavItemStyle}" Click="OnNavigationClicked" />
                    <RadioButton x:Name="DictationNav" Content="Dictation" Tag="&#xE720;" GroupName="Navigation"
                                 Style="{StaticResource NavItemStyle}" Click="OnNavigationClicked" />
                    <RadioButton x:Name="ContextNav" Content="Visual context" Tag="&#xE91B;" GroupName="Navigation"
                                 Style="{StaticResource NavItemStyle}" Click="OnNavigationClicked" />
                    <RadioButton x:Name="ShortcutsNav" Content="Shortcuts" Tag="&#xE765;" GroupName="Navigation"
                                 Style="{StaticResource NavItemStyle}" Click="OnNavigationClicked" />
                    <RadioButton x:Name="StorageNav" Content="Storage" Tag="&#xE8B7;" GroupName="Navigation"
                                 Style="{StaticResource NavItemStyle}" Click="OnNavigationClicked" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="8,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Local processing" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="Audio stays on this PC" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="Overview" Style="{StaticResource PageHeadingStyle}" />
                        <TextBlock x:Name="PageDescriptionText" Text="Your recording setup at a glance."
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                            <Ellipse x:Name="SaveStatusDot" Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                                     Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="SaveStatusText" Text="Changes save automatically"
                                       FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Button Content="Done" Style="{StaticResource PrimaryButtonStyle}" Click="OnDoneClicked"
                                IsDefault="True" MinWidth="72" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="30,22,30,26">
                <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="2" />
                                <StackPanel Grid.Column="1" Margin="16,0,28,0">
                                    <TextBlock Text="Ready to dictate" Style="{StaticResource SectionHeadingStyle}" />
                                    <TextBlock Text="Speak from any app, add visual context when needed, and keep processing on this computer."
                                               FontSize="12" LineHeight="18" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Dictation settings" Style="{StaticResource PrimaryButtonStyle}"
                                            Click="OnOpenDictationClicked" Margin="0,0,8,0" />
                                    <Button Content="Visual context" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OnOpenContextClicked" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Current configuration" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,10" />
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Microphone" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="OverviewMicLabel" Grid.Column="1" Text="System microphone"
                                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8" />
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Language and model" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock x:Name="OverviewLanguageLabel" Text="English" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock x:Name="OverviewModelLabel" Text="Balanced" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8" />
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Quick note" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="OverviewShortcutLabel" Grid.Column="1" Text="Hold Alt"
                                               FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Workflow" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Three steps, without switching applications."
                                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,16" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="1" Style="{StaticResource UtilityTextStyle}" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="Speak" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,3" />
                                        <TextBlock Text="Start a quick note from the active field." FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />
                                    <StackPanel Grid.Column="2" Margin="18,0">
                                        <TextBlock Text="2" Style="{StaticResource UtilityTextStyle}" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="Circle" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,3" />
                                        <TextBlock Text="Reference an area while recording." FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Background="{StaticResource BorderBrush}" />
                                    <StackPanel Grid.Column="4" Margin="18,0,0,0">
                                        <TextBlock Text="3" Style="{StaticResource UtilityTextStyle}" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="Continue" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,3" />
                                        <TextBlock Text="Receive text and images in the original app." FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="DictationPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Voice input" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Choose the input device and local speech model."
                                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,18" />
                                <TextBlock Text="Microphone" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="MicComboBox" Height="36" SelectionChanged="OnMicChanged" />
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Transcription language" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="LanguageComboBox" Height="36" SelectionChanged="OnLanguageChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Model" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="ModelSizeComboBox" Height="36" SelectionChanged="OnModelSizeChanged" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ModelHintText" Text="Balanced gives the best everyday speed and accuracy."
                                           FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Text processing" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Optional cleanup runs locally before text returns to the active app."
                                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,18" />
                                <CheckBox x:Name="DeveloperCleanupCheckBox" Style="{StaticResource SwitchStyle}"
                                          Checked="OnDeveloperCleanupToggled" Unchecked="OnDeveloperCleanupToggled">
                                    <StackPanel>
                                        <TextBlock Text="Developer vocabulary" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Correct common technical names and terms from your custom dictionary."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </CheckBox>
                                <Button Content="Open custom vocabulary" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Left" Margin="48,10,0,16" Click="OnOpenVocabularyClicked" />
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />
                                <CheckBox x:Name="GrammarCorrectionCheckBox" Style="{StaticResource SwitchStyle}"
                                          Checked="OnGrammarToggled" Unchecked="OnGrammarToggled">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Grammar correction" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Beta" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="8,2,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="GrammarHintText"
                                                   Text="Polish English punctuation and sentence structure with local ONNX inference."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ContextPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Screenshot behavior" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Choose what BetterVoice saves and pastes after you circle an area. One mode is active at a time."
                                           FontSize="12" LineHeight="18" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,16" />
                                <RadioButton x:Name="FullDisplayModeRadio" GroupName="CaptureMode"
                                             Style="{StaticResource CaptureModeStyle}"
                                             Checked="OnCaptureModeChanged" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Full display with highlight" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Default" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="8,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="Keep the target monitor and mark the circled area."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="CroppedSelectionModeRadio" GroupName="CaptureMode"
                                             Style="{StaticResource CaptureModeStyle}"
                                             Checked="OnCaptureModeChanged">
                                    <StackPanel>
                                        <TextBlock Text="Cropped selection" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Save and paste only the circled region."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="The pointer trail stays visible while drawing but is excluded from the saved image."
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Circle completion" Style="{StaticResource SectionHeadingStyle}" />
                                        <TextBlock Text="Higher values require a more complete circle and reduce accidental captures."
                                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="AngleLabel" Grid.Column="1" Text="340°"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="AngleSlider" Minimum="300" Maximum="359" Value="340" TickFrequency="1"
                                        Style="{StaticResource ProfessionalSliderStyle}"
                                        IsSnapToTickEnabled="True" ValueChanged="OnAngleChanged" Margin="0,20,0,8" />
                                <Grid>
                                    <TextBlock Text="Looser" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="Stricter" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ShortcutsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Quick-note trigger" Style="{StaticResource SectionHeadingStyle}" />
                                    <TextBlock Text="Choose how Alt starts and stops a short recording."
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,18" />
                                    <TextBlock Text="Trigger behavior" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="TriggerModeComboBox" Height="36" SelectionChanged="OnTriggerModeChanged">
                                        <ComboBoxItem Content="Hold Alt to record" />
                                        <ComboBoxItem Content="Press Alt to toggle" />
                                        <ComboBoxItem Content="Double-tap Alt to toggle" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border CornerRadius="6" Background="#181B20" BorderBrush="#454B55"
                                            BorderThickness="1" Padding="20,12">
                                        <TextBlock Text="Alt" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="16" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="Global shortcut" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,9,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Hold delay" Style="{StaticResource SectionHeadingStyle}" />
                                        <TextBlock Text="How long Alt must stay down before recording begins."
                                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="HoldDelayLabel" Grid.Column="1" Text="140 ms"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="HoldDelaySlider" Minimum="50" Maximum="500" Value="140" TickFrequency="10"
                                        Style="{StaticResource ProfessionalSliderStyle}"
                                        IsSnapToTickEnabled="True" ValueChanged="OnHoldDelayChanged" Margin="0,20,0,8" />
                                <Grid>
                                    <TextBlock Text="50 ms" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="500 ms" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="StoragePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Top" Margin="0,5,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Processed locally" Style="{StaticResource SectionHeadingStyle}" />
                                    <TextBlock Text="Transcription, vocabulary cleanup, grammar correction, and screenshot encoding run on this computer."
                                               FontSize="12" LineHeight="18" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Session recordings" Style="{StaticResource SectionHeadingStyle}" />
                                    <TextBlock Text="Review saved audio and screenshot context in the local sessions folder."
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,14" />
                                    <TextBlock Text="%LOCALAPPDATA%\BetterVoice\Sessions"
                                               Style="{StaticResource UtilityTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open folder" Style="{StaticResource SecondaryButtonStyle}"
                                        VerticalAlignment="Center" Click="OnOpenSessionsClicked" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
